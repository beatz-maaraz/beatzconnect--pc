<Window x:Class="PCControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beatz Control"
        Height="720" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ── Palette ────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgDeep"         Color="#070B14"/>
        <SolidColorBrush x:Key="BgSurface"      Color="#0D1526"/>
        <SolidColorBrush x:Key="BgCard"         Color="#111C30"/>
        <SolidColorBrush x:Key="BgCardAlt"      Color="#0F1A2B"/>
        <SolidColorBrush x:Key="BorderSubtle"   Color="#1E2D45"/>
        <SolidColorBrush x:Key="BorderMid"      Color="#263550"/>
        <SolidColorBrush x:Key="AccentCyan"     Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentIndigo"   Color="#818CF8"/>
        <SolidColorBrush x:Key="AccentGreen"    Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber"    Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed"      Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#4B6180"/>

        <!-- ── Gradients ──────────────────────────────────────────────────── -->
        <LinearGradientBrush x:Key="GradientCyan" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#22D3EE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradientBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#818CF8" Offset="0.5"/>
            <GradientStop Color="#0D1526" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradientTitleBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#090E1A" Offset="0"/>
            <GradientStop Color="#0D1526" Offset="1"/>
        </LinearGradientBrush>

        <!-- ── Shared Drop Shadows ────────────────────────────────────────── -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
        <DropShadowEffect x:Key="GlowCyan"  Color="#22D3EE"  BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="GlowGreen" Color="#10B981"  BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>

        <!-- ── Card Border Style ──────────────────────────────────────────── -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="14"/>
            <Setter Property="Padding"          Value="20"/>
            <Setter Property="Effect"           Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- ── Inner info block ──────────────────────────────────────────── -->
        <Style x:Key="InfoBlock" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgCardAlt}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="14,12"/>
            <Setter Property="Margin"           Value="0,0,0,12"/>
        </Style>

        <!-- ── Base Button ────────────────────────────────────────────────── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"       Value="#182438"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderMid}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="14,8"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="#1F3250"/>
                                <Setter TargetName="bd" Property="BorderBrush"  Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="#223560"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Cyan Button ───────────────────────────────────────── -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"    Value="{StaticResource GradientCyan}"/>
            <Setter Property="Foreground"    Value="#071018"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"    Value="Bold"/>
        </Style>

        <!-- ── Danger Button ──────────────────────────────────────────────── -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"   Value="#2A0E0E"/>
            <Setter Property="BorderBrush"  Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground"   Value="#FCA5A5"/>
        </Style>

        <!-- ── Window chrome buttons ─────────────────────────────────────── -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width"            Value="34"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2D45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab Radio Button ───────────────────────────────────────────── -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground"   Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Margin"       Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" Padding="13,7" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#182438"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Volume Slider ──────────────────────────────────────────────── -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" Background="#182438" CornerRadius="3"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="5" Background="{StaticResource GradientCyan}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="{StaticResource AccentCyan}"
                                                         Stroke="#FFFFFF" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#22D3EE" BlurRadius="8"
                                                                          ShadowDepth="0" Opacity="0.75"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Log TextBox ────────────────────────────────────────────────── -->
        <Style x:Key="LogBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#070B14"/>
            <Setter Property="Foreground"       Value="#7DD3FC"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Consolas, Courier New"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="IsReadOnly"       Value="True"/>
            <Setter Property="TextWrapping"     Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="Padding"          Value="10"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROOT BORDER — outer glow + rounded corners
    ══════════════════════════════════════════════════════════════════════ -->
    <Border Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource GradientBorder}"
            BorderThickness="1.2"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>   <!-- Content -->
                <RowDefinition Height="36"/>  <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════════
                 TITLE BAR
            ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource GradientTitleBar}"
                    CornerRadius="18,18,0,0"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Logo + title -->
                        <ColumnDefinition Width="*"/>     <!-- Nav tabs (centred) -->
                        <ColumnDefinition Width="Auto"/>  <!-- Window chrome -->
                    </Grid.ColumnDefinitions>

                    <!-- Logo + branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                Background="{StaticResource GradientCyan}"
                                CornerRadius="9" Margin="0,0,10,0">
                            <TextBlock Text="♪" FontSize="16" Foreground="#071018"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BEATZ CONTROL"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Border Background="#182438" CornerRadius="4"
                                        Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="v2.0" FontSize="9"
                                               Foreground="{StaticResource AccentCyan}"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Cloud Relay · Remote Control"
                                       FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="TabDashboard" Content="Dashboard"
                                     Style="{StaticResource NavTab}" IsChecked="True"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabApps"      Content="Active Apps"
                                     Style="{StaticResource NavTab}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSettings"  Content="Settings"
                                     Style="{StaticResource NavTab}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabLogs"      Content="Activity Log"
                                     Style="{StaticResource NavTab}"
                                     Checked="Tab_Checked"/>
                    </StackPanel>

                    <!-- Window chrome: Minimize / Maximize / Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button x:Name="BtnMinimize" Style="{StaticResource ChromeButton}"
                                Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Path Data="M4,10 H16" Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource ChromeButton}"
                                Click="BtnMaximize_Click" ToolTip="Maximize / Restore" Margin="2,0">
                            <Path x:Name="MaximizeIcon"
                                  Data="M4,4 H16 V16 H4 Z"
                                  Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.5" Fill="Transparent"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource ChromeButton}"
                                Click="BtnClose_Click" ToolTip="Close to tray" Margin="2,0,0,0">
                            <Grid Width="12" Height="12">
                                <Path Data="M0,0 L12,12" Stroke="{StaticResource AccentRed}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M12,0 L0,12" Stroke="{StaticResource AccentRed}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════
                 MAIN CONTENT AREA
            ══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="18,16,18,12">

                <!-- ── 1. DASHBOARD ──────────────────────────────────────── -->
                <Grid x:Name="ViewDashboard" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: Relay connection -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Panel header -->
                                <TextBlock Text="RELAY CONNECTION"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyan}" Margin="0,0,0,14"/>

                                <!-- Live connection badge -->
                                <Border x:Name="BadgeRelay"
                                        Background="#1A1000"
                                        BorderBrush="{StaticResource AccentAmber}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="14,12" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="DotStatus" Width="11" Height="11"
                                                 Fill="{StaticResource AccentAmber}"
                                                 Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#F59E0B" BlurRadius="10"
                                                                  ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRelayStatus"
                                                       Text="Connecting to relay…"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock x:Name="TxtRelayDetail"
                                                       Text="backend-n4yg.onrender.com"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="BadgeRoomId"
                                                Background="#0D1526" CornerRadius="6"
                                                Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRoomId" Text="—"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentIndigo}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- PC Info block -->
                                <Border Style="{StaticResource InfoBlock}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <StackPanel>
                                                <TextBlock Text="COMPUTER" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtPcName" Text="—"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="RESOLUTION" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMuted}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="TxtResolution" Text="—"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentIndigo}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <StackPanel>
                                                <TextBlock Text="ROOM ID" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtRoomIdFull" Text="—"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentCyan}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Content="Copy Room ID"
                                                    Style="{StaticResource ActionButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Padding="10,6" Click="BtnCopyRoomId_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Relay server info -->
                                <Border Style="{StaticResource InfoBlock}">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="RELAY SERVER" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock x:Name="TxtRelayUrl"
                                                       Text="backend-n4yg.onrender.com"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnReconnect" Content="↺  Reconnect"
                                                Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Padding="10,6" Click="BtnReconnect_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Hotspot toggle (still useful for LAN fallback) -->
                                <Border Style="{StaticResource InfoBlock}" Margin="0,0,0,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="WI-FI LAN HOTSPOT"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Optional — for offline / LAN-only mode"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnToggleHotspot" Content="Start Hotspot"
                                                Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="BtnToggleHotspot_Click"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- RIGHT PANEL: Hardware & controls -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Panel header -->
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="HARDWARE &amp; TELEMETRY"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyan}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse x:Name="DotPulse" Width="8" Height="8"
                                                 Fill="{StaticResource AccentCyan}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Live" FontSize="10"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Telemetry stats row -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource InfoBlock}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="PACKETS" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock x:Name="TxtPacketCount" Text="0"
                                                       FontSize="20" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource InfoBlock}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="CURSOR" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock x:Name="TxtCursorCoords" Text="0, 0"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource InfoBlock}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="RELAY" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock x:Name="TxtLatency" Text="—"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentGreen}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Volume control -->
                                <Border Style="{StaticResource InfoBlock}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Master Volume"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <Border x:Name="BadgeMuted"
                                                        Background="#2A0E0E" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="MUTED" FontSize="9" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentRed}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtVolumePercent" Text="50%"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Slider x:Name="SliderVolume" Minimum="0" Maximum="100" Value="50"
                                                Style="{StaticResource VolumeSlider}"
                                                ValueChanged="SliderVolume_ValueChanged"
                                                Margin="0,4,0,12"/>

                                        <Grid>
                                            <Button x:Name="BtnMute" Content="🔊  Mute"
                                                    Style="{StaticResource ActionButton}"
                                                    HorizontalAlignment="Left"
                                                    Click="BtnMute_Click"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="⏮" Style="{StaticResource ActionButton}"
                                                        Width="36" Margin="0,0,6,0"
                                                        Click="BtnPrev_Click"/>
                                                <Button Content="⏯  Play" Style="{StaticResource PrimaryButton}"
                                                        Margin="0,0,6,0" Click="BtnPlayPause_Click"/>
                                                <Button Content="⏭" Style="{StaticResource ActionButton}"
                                                        Width="36" Click="BtnNext_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Test trackpad -->
                                <Border Style="{StaticResource InfoBlock}">
                                    <StackPanel>
                                        <TextBlock Text="DESKTOP TEST TRACKPAD"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,0,0,8"/>
                                        <Border x:Name="TestTrackpadArea" Height="80"
                                                Background="#070B14"
                                                BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1" CornerRadius="8" Cursor="Cross"
                                                MouseDown="TestTrackpad_MouseDown"
                                                MouseMove="TestTrackpad_MouseMove">
                                            <TextBlock Text="🖱  Click &amp; drag to control cursor"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Quick triggers -->
                                <TextBlock Text="QUICK ACTIONS"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,8"/>
                                <UniformGrid Columns="2" Rows="2">
                                    <Button Content="🔒  Lock Workstation"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,0,6,6" Click="BtnLock_Click"/>
                                    <Button Content="🖥  Show Desktop"
                                            Style="{StaticResource ActionButton}"
                                            Margin="6,0,0,6" Click="BtnShowDesktop_Click"/>
                                    <Button Content="🌙  Sleep"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,0,6,0" Click="BtnSleep_Click"/>
                                    <Button Content="⚙  Task Manager"
                                            Style="{StaticResource ActionButton}"
                                            Margin="6,0,0,0" Click="BtnTaskManager_Click"/>
                                </UniformGrid>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── 2. ACTIVE APPS ─────────────────────────────────────── -->
                <Grid x:Name="ViewApps" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE WINDOWS &amp; APPLICATION MANAGER"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyan}"/>
                                    <TextBlock Text="All controllable desktop applications."
                                               FontSize="10" Foreground="{StaticResource TextMuted}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="↺  Refresh" Style="{StaticResource ActionButton}"
                                            Margin="0,0,8,0" Click="BtnRefreshApps_Click"/>
                                    <Button Content="✕  Close Selected" Style="{StaticResource DangerButton}"
                                            Click="BtnCloseSelectedApp_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="DataGridApps" Grid.Row="1"
                                      Background="#070B14" Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowBackground="#0D1526" AlternatingRowBackground="#111C30"
                                      RowHeight="34" ColumnHeaderHeight="32">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#182438"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="FontSize"   Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding"    Value="10,0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process"     Binding="{Binding ProcessName}" Width="160"/>
                                    <DataGridTextColumn Header="PID"         Binding="{Binding ProcessId}"   Width="80"/>
                                    <DataGridTextColumn Header="Window Title" Binding="{Binding Title}"      Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── 3. SETTINGS ───────────────────────────────────────── -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                                <TextBlock Text="SETTINGS &amp; SERVICE"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyan}"
                                           Margin="0,0,0,20"/>

                                <!-- Relay URL override -->
                                <TextBlock Text="RELAY SERVER URL" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource BgCardAlt}"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="8" Padding="0,0,10,0">
                                        <TextBox x:Name="TxtRelayUrlInput"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderThickness="0" FontSize="12" Padding="12,9"
                                                 Text="https://backend-n4yg.onrender.com"
                                                 VerticalContentAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Apply &amp; Reconnect"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="BtnApplyRelayUrl_Click"/>
                                </Grid>

                                <!-- Windows Service management -->
                                <TextBlock Text="WINDOWS BACKGROUND SERVICE" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,8"/>
                                <Border Style="{StaticResource InfoBlock}">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtServiceStatus"
                                                   Text="Status: Checking…"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentAmber}"
                                                   Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="▶  Install Service"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0,0,8,0" Click="BtnInstallService_Click"/>
                                            <Button Content="■  Uninstall Service"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="BtnUninstallService_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Firewall rule -->
                                <TextBlock Text="FIREWALL" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,8"/>
                                <Border Style="{StaticResource InfoBlock}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Allow Beatz Control through Windows Firewall"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Opens TCP port 8080 for LAN fallback mode."
                                                       FontSize="10" Foreground="{StaticResource TextMuted}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Content="Add Firewall Rule"
                                                Style="{StaticResource ActionButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="BtnAddFirewall_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Startup options -->
                                <TextBlock Text="STARTUP" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,0,8"/>
                                <Border Style="{StaticResource InfoBlock}" Margin="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows"
                                                  Content="Start Beatz Control with Windows"
                                                  Foreground="{StaticResource TextPrimary}"
                                                  FontSize="12" Margin="0,0,0,8"
                                                  Checked="ChkStartWithWindows_Changed"
                                                  Unchecked="ChkStartWithWindows_Changed"/>
                                        <CheckBox x:Name="ChkMinimizeToTray"
                                                  Content="Minimize to tray instead of closing"
                                                  Foreground="{StaticResource TextPrimary}"
                                                  FontSize="12" IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── 4. ACTIVITY LOG ───────────────────────────────────── -->
                <Grid x:Name="ViewLogs" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="ACTIVITY LOG"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyan}"
                                           VerticalAlignment="Center"/>
                                <Button Content="Clear" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Right" Padding="12,6"
                                        Click="BtnClearLogs_Click"/>
                            </Grid>

                            <TextBox x:Name="TxtLogs" Grid.Row="1"
                                     Style="{StaticResource LogBox}"/>

                            <TextBlock Grid.Row="2"
                                       Text="Relay events, command executions and errors are shown here."
                                       FontSize="10" Foreground="{StaticResource TextMuted}"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <!-- ══════════════════════════════════════════════════════════════
                 STATUS BAR
            ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSurface}"
                    CornerRadius="0,0,18,18"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStatusBar" Width="7" Height="7"
                                 Fill="{StaticResource AccentAmber}" Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatusBar"
                                   Text="Initialising…"
                                   FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Beatz Control  ·  " FontSize="10"
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="© 2026" FontSize="10"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
