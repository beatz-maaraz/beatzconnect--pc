<Window x:Class="PCControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Beatz Control"
        Height="740" Width="1120"
        MinHeight="660" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1C1C1C"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <!-- ── Windows 11 Native Snap Layout & Hardware-Accelerated Chrome ── -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ── Palette Brushes ────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgBase"            Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BgSidebar"         Color="#202020"/>
        <SolidColorBrush x:Key="SurfaceCard"       Color="#2B2B2B"/>
        <SolidColorBrush x:Key="SurfaceHover"      Color="#323232"/>
        <SolidColorBrush x:Key="SurfaceTile"       Color="#262626"/>
        <SolidColorBrush x:Key="SurfaceInput"      Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AccentPrimary"     Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentLight"       Color="#60CDFF"/>
        <SolidColorBrush x:Key="AccentSubtle"      Color="#2060CDFF"/>
        <SolidColorBrush x:Key="StateSuccess"      Color="#10B981"/>
        <SolidColorBrush x:Key="StateWarning"      Color="#F59E0B"/>
        <SolidColorBrush x:Key="StateDanger"       Color="#EF4444"/>
        <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C"/>
        <SolidColorBrush x:Key="TextPrimary"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary"     Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextTertiary"      Color="#8A8A8A"/>
        <SolidColorBrush x:Key="BorderSubtle"      Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="BorderControl"     Color="#1FFFFFFF"/>

        <!-- ── Drop Shadow Effects ────────────────────────────────────── -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.32"/>
        <DropShadowEffect x:Key="DotGlowGreen" Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="DotGlowAmber" Color="#F59E0B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>

        <!-- ── Titlebar Caption Button Style ──────────────────────────── -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CaptionCloseHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A82315"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Sidebar Nav Item Style (RadioButton) ────────────────────── -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,0">
                            <Grid>
                                <!-- Active Left Indicator Pill -->
                                <Border x:Name="activeIndicator"
                                        Width="3" Height="18"
                                        Background="{StaticResource AccentLight}"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#17FFFFFF"/>
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Standard Action Button Style ────────────────────────────── -->
        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceTile}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Accent Primary Button Style ─────────────────────────────── -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource StandardBtn}">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1084D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger Tile Button Style ────────────────────────────────── -->
        <Style x:Key="DangerTileBtn" TargetType="Button" BasedOn="{StaticResource StandardBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33EF4444"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66EF4444"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Volume Slider Style ─────────────────────────────────────── -->
        <Style x:Key="FluentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#28FFFFFF" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="{StaticResource AccentLight}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="{StaticResource AccentLight}"
                                                         Stroke="#FFFFFF" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         MAIN WINDOW ROOT GRID
    ══════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>  <!-- WinUI Titlebar -->
            <RowDefinition Height="*"/>   <!-- Main Split Shell -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             1. WINDOWS 11 FLUENT FRAMELESS TITLEBAR
        ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- App Brand & Icon -->
                    <ColumnDefinition Width="*"/>    <!-- Drag & Live IPC Badge -->
                    <ColumnDefinition Width="Auto"/> <!-- Caption Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Brand Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Modern Windows 11 App Icon -->
                    <Border Width="22" Height="22" Background="#0078D4" CornerRadius="5" Margin="0,0,10,0">
                        <TextBlock Text="📱" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Beatz Control" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentSubtle}" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="COMPANION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentLight}"/>
                    </Border>
                </StackPanel>

                <!-- Center/Drag Area & Live IPC Handshake Badge -->
                <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="PillIpcStatus"
                            Background="#1A10B981"
                            BorderBrush="#3310B981"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            ToolTip="Local WebSocket / Named Pipe Zero-Latency IPC Bridge">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotIpcStatus" Width="7" Height="7" Fill="{StaticResource StateSuccess}" Margin="0,0,7,0"
                                     Effect="{StaticResource DotGlowGreen}"/>
                            <TextBlock x:Name="TxtIpcStatus" Text="Connected • &lt;1ms" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Native Caption Controls (Minimize, Maximize, Tray, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Minimize -->
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtnStyle}" ToolTip="Minimize" Click="BtnMinimize_Click">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtnStyle}" ToolTip="Maximize" Click="BtnMaximize_Click">
                        <Grid Width="10" Height="10">
                            <Rectangle x:Name="IconMaximize" Width="10" Height="10"
                                       Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.1" RadiusX="1" RadiusY="1"/>
                            <Canvas x:Name="IconRestore" Width="10" Height="10" Visibility="Collapsed">
                                <Rectangle Canvas.Left="2" Canvas.Top="0" Width="8" Height="8"
                                           Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1" RadiusX="0.8" RadiusY="0.8"/>
                                <Path Data="M0,2.5 L0,10 L7.5,10"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Button>

                    <!-- Minimize to Tray -->
                    <Button x:Name="BtnHideTray" Style="{StaticResource CaptionBtnStyle}" ToolTip="Minimize to System Tray" Click="BtnHideTray_Click">
                        <Path Data="M5,0 L5,7 M2,4 L5,7 L8,4 M0,9 L10,9"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <!-- Close -->
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" ToolTip="Close" Click="BtnClose_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             2. MAIN FLUENT SHELL: SIDEBAR + VIEWPORT
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/> <!-- Left Navigation Rail -->
                <ColumnDefinition Width="*"/>   <!-- Right Main Viewport -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT NAVIGATION RAIL ─────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Device Glance Card -->
                        <RowDefinition Height="Auto"/> <!-- Nav Items List -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Media Player -->
                    </Grid.RowDefinitions>

                    <!-- Device Glance Card -->
                    <Border Grid.Row="0"
                            x:Name="CardDeviceGlance"
                            Background="{StaticResource SurfaceCard}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Silhouette -->
                                <ColumnDefinition Width="*"/>    <!-- Meta info -->
                            </Grid.ColumnDefinitions>

                            <!-- Phone Silhouette -->
                            <Border Grid.Column="0"
                                    Width="36" Height="60"
                                    Background="#111418"
                                    BorderBrush="#3F4756"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Margin="0,0,12,0">
                                <Border Margin="2" Background="#1A2230" CornerRadius="3">
                                    <TextBlock x:Name="TxtGlanceClock" Text="12:00"
                                               FontSize="8.5" FontWeight="Bold"
                                               Foreground="{StaticResource AccentLight}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>

                            <!-- Meta -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSidebarDeviceName"
                                           Text="No Device Connected"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                    <!-- Battery Micro Chassis -->
                                    <Border Width="20" Height="10"
                                            BorderBrush="#B3FFFFFF"
                                            BorderThickness="1.2"
                                            CornerRadius="2"
                                            Padding="1"
                                            VerticalAlignment="Center">
                                        <Border x:Name="BarSidebarBattery"
                                                Width="14" Height="6"
                                                Background="{StaticResource StateSuccess}"
                                                CornerRadius="1"
                                                HorizontalAlignment="Left"/>
                                    </Border>
                                    <TextBlock x:Name="TxtSidebarBattery"
                                               Text="--%"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="5,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="📶 5G" FontSize="10.5" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DotSidebarConn" Width="6" Height="6" Fill="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtSidebarConn" Text="Awaiting pairing…" FontSize="10.5" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavTabStatus" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Device Status" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTabApps" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Phone Apps" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTabLogs" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Activity Logs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTabSettings" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Media Player Card -->
                    <Border Grid.Row="3"
                            Background="{StaticResource SurfaceCard}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" Background="#19202A"
                                    BorderBrush="#3360CDFF" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMediaTitle" Text="No Media Playing" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtMediaArtist" Text="Beatz Companion" FontSize="10.5" Foreground="{StaticResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnMediaPlay" Style="{StaticResource StandardBtn}" Padding="8,4" Click="BtnMediaPlay_Click">
                                    <TextBlock x:Name="IconMediaPlayText" Text="▶" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── RIGHT MAIN VIEWPORT ─────────────────────────────────── -->
            <Grid Grid.Column="1" Background="{StaticResource BgBase}">

                <!-- ══════════════════════════════════════════════════════════
                     TAB 0: DEVICE STATUS PANE
                ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="PaneStatus" VerticalScrollBarVisibility="Auto" Padding="28,24,28,28" Visibility="Visible">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock x:Name="TxtHeaderDeviceName" Text="No Device Connected" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Synchronized seamlessly with your Windows PC" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#1A60CDFF" BorderBrush="#3360CDFF" BorderThickness="1" CornerRadius="16" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentLight}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtRelayPill" Text="Relay Online" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentLight}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Hero Overview Card -->
                        <Border Background="{StaticResource SurfaceCard}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24"
                                Margin="0,0,0,20"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left hero text & quick toggles -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border x:Name="BadgeHeroConnState" Background="#26F59E0B" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock x:Name="TxtHeroConnState" Text="SEARCHING FOR PHONE" FontSize="11" FontWeight="Bold" Foreground="#FCD34D"/>
                                        </Border>
                                        <Border Background="#0DFFFFFF" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="Wi-Fi (Port 8080) &amp; Cloud Relay" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtHeroTitle" Text="Waiting for Device" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtHeroDesc"
                                               Text="Awaiting companion connection. Pair the mobile app on your local Wi-Fi or via the secure cloud relay to enable remote control, audio sync, and instant notifications."
                                               FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19" MaxWidth="620"/>

                                    <!-- Quick Toggles Row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <!-- DND -->
                                        <Border Background="{StaticResource SurfaceTile}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔕" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Do Not Disturb" FontSize="10.5" Foreground="{StaticResource TextTertiary}"/>
                                                    <TextBlock x:Name="TxtValDnd" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bluetooth -->
                                        <Border Background="{StaticResource SurfaceTile}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📶" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Bluetooth Audio" FontSize="10.5" Foreground="{StaticResource TextTertiary}"/>
                                                    <TextBlock x:Name="TxtValBt" Text="Connected" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cloud Relay Node -->
                                        <Border Background="{StaticResource SurfaceTile}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="☁️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Relay Node" FontSize="10.5" Foreground="{StaticResource TextTertiary}"/>
                                                    <TextBlock x:Name="TxtValRelay" Text="backend-n4yg" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Circular Battery Gauge -->
                                <Border Grid.Column="1" Width="120" Height="120"
                                        Background="{StaticResource SurfaceTile}"
                                        BorderBrush="{StaticResource BorderControl}"
                                        BorderThickness="2"
                                        CornerRadius="60"
                                        VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtBatteryBolt" Text="⚡" FontSize="13" Foreground="#FBBF24" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtHeroBatteryNum" Text="--%" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHeroBatteryState" Text="Disconnected" FontSize="11" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2-Column Controls Grid -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Volume Controller Card -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceCard}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔊" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Workstation Master Volume" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="{StaticResource AccentSubtle}" CornerRadius="4" Padding="8,2">
                                            <TextBlock x:Name="TxtVolumeBadge" Text="50%" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentLight}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Sync and adjust PC master audio directly through companion bridge." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderVolume" Grid.Column="0" Style="{StaticResource FluentSliderStyle}"
                                                Minimum="0" Maximum="100" Value="50" Margin="0,0,14,0"
                                                ValueChanged="SliderVolume_ValueChanged"/>
                                        <Button x:Name="BtnToggleMute" Grid.Column="1" Style="{StaticResource StandardBtn}" Click="BtnToggleMute_Click">
                                            <TextBlock x:Name="TxtMuteBtn" Text="Mute"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- PC Power Controls Card -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource SurfaceCard}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="⚡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PC Power Controls" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Execute immediate workstation power states via background service." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                                    <UniformGrid Columns="4">
                                        <Button x:Name="BtnLockPc" Style="{StaticResource StandardBtn}" Margin="0,0,6,0" Click="BtnLockPc_Click">
                                            <StackPanel>
                                                <TextBlock Text="🔒" FontSize="14" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Lock PC" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSleepPc" Style="{StaticResource StandardBtn}" Margin="0,0,6,0" Click="BtnSleepPc_Click">
                                            <StackPanel>
                                                <TextBlock Text="🌙" FontSize="14" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Sleep" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnRestartPc" Style="{StaticResource StandardBtn}" Margin="0,0,6,0" Click="BtnRestartPc_Click">
                                            <StackPanel>
                                                <TextBlock Text="🔄" FontSize="14" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Restart" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnShutdownPc" Style="{StaticResource DangerTileBtn}" Click="BtnShutdownPc_Click">
                                            <StackPanel>
                                                <TextBlock Text="⏻" FontSize="14" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Shutdown" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Telemetry Data Strip -->
                        <Border Background="{StaticResource SurfaceCard}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,12">
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="HOST WORKSTATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock x:Name="TxtTelemetryHost" Text="This PC" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="ACTIVE USER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock x:Name="TxtTelemetryUser" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="LOCAL IPC BRIDGE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock x:Name="TxtTelemetryIpc" Text="&lt; 1 ms (Loopback)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentLight}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CLOUD RELAY ID" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextTertiary}"/>
                                    <TextBlock x:Name="TxtTelemetryRoomId" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════════════════════
                     TAB 1: PHONE APPS PANE
                ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="PaneApps" VerticalScrollBarVisibility="Auto" Padding="28,24,28,28" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Phone Apps &amp; Screen Mirror" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Cast phone display or launch apps directly from PC" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnOpenMirror" Style="{StaticResource AccentBtn}" HorizontalAlignment="Right" Click="BtnOpenMirror_Click">
                                <TextBlock Text="🖥️ Open Phone Screen"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="PINNED PHONE APPS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>

                        <!-- Squircle App Icons Grid -->
                        <WrapPanel Margin="0,0,0,24">
                            <!-- Spotify -->
                            <Button Style="{StaticResource StandardBtn}" Width="100" Height="100" Margin="0,0,12,12" Click="BtnAppTile_Click" Tag="Spotify">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" Background="#1DB954" CornerRadius="14" Margin="0,0,0,6">
                                        <TextBlock Text="🎧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Spotify" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- WhatsApp -->
                            <Button Style="{StaticResource StandardBtn}" Width="100" Height="100" Margin="0,0,12,12" Click="BtnAppTile_Click" Tag="WhatsApp">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" Background="#25D366" CornerRadius="14" Margin="0,0,0,6">
                                        <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="WhatsApp" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Camera -->
                            <Button Style="{StaticResource StandardBtn}" Width="100" Height="100" Margin="0,0,12,12" Click="BtnAppTile_Click" Tag="Camera">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" Background="#3B82F6" CornerRadius="14" Margin="0,0,0,6">
                                        <TextBlock Text="📷" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Camera" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Gallery -->
                            <Button Style="{StaticResource StandardBtn}" Width="100" Height="100" Margin="0,0,12,12" Click="BtnAppTile_Click" Tag="Gallery">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" Background="#F59E0B" CornerRadius="14" Margin="0,0,0,6">
                                        <TextBlock Text="🖼️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Gallery" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- YouTube -->
                            <Button Style="{StaticResource StandardBtn}" Width="100" Height="100" Margin="0,0,12,12" Click="BtnAppTile_Click" Tag="YouTube">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" Background="#EF4444" CornerRadius="14" Margin="0,0,0,6">
                                        <TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="YouTube" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button Style="{StaticResource StandardBtn}" Width="100" Height="100" Margin="0,0,12,12" Click="BtnAppTile_Click" Tag="Settings">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="50" Height="50" Background="#64748B" CornerRadius="14" Margin="0,0,0,6">
                                        <TextBlock Text="⚙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="ACTIVE WORKSTATION WINDOWS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <Border Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource StateSuccess}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Beatz Control (Active Companion UI)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════════════════════════════════════
                     TAB 2: ACTIVITY LOGS PANE
                ══════════════════════════════════════════════════════════ -->
                <Grid x:Name="PaneLogs" Margin="28,24,28,28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Activity Logs" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Real-time background service and WebSocket IPC telemetry events" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnClearLogs" Grid.Row="0" Style="{StaticResource StandardBtn}" HorizontalAlignment="Right" Click="BtnClearLogs_Click">
                            <TextBlock Text="🗑️ Clear Logs"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#141414"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <TextBox x:Name="TxtConsoleLog"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#60CDFF"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════
                     TAB 3: SETTINGS PANE
                ══════════════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="PaneSettings" VerticalScrollBarVisibility="Auto" Padding="28,24,28,28" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Settings &amp; Preferences" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Manage startup, tray persistence, and cloud relay networking" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,20"/>

                        <Border Background="{StaticResource SurfaceCard}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <!-- Setting 1: Cloud Relay -->
                                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Cloud Relay Endpoint" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Worldwide connection relay when away from local Wi-Fi" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtRelayUrlInput" HorizontalAlignment="Right" Width="280"
                                                 Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource BorderControl}"
                                                 Foreground="#FFFFFF" Padding="10,6" FontSize="12" IsReadOnly="True"/>
                                    </Grid>
                                </Border>

                                <!-- Setting 2: Launch on Startup -->
                                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Launch Silently at Windows Startup" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Start background service and keep companion in system tray on login" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" HorizontalAlignment="Right" IsChecked="True"
                                                  Click="ChkStartWithWindows_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Setting 3: Close to Tray -->
                                <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Close Button Minimizes to System Tray" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Closing dashboard window keeps background service active" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkCloseToTray" HorizontalAlignment="Right" IsChecked="True"/>
                                    </Grid>
                                </Border>

                                <!-- Setting 4: Backend Architecture -->
                                <Border Padding="20,16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Backend Architecture" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Self-contained .NET 8 binary with zero external runtime requirements" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="Self-Contained (Win-x64)" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>
